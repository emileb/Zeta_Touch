# IDE state. Must be ".idea/*", not ".idea/" -- git cannot re-include a file
# inside an excluded directory, so the negations below are dead with a bare dir.
/.idea/*

# Shared project config that is checked in
!/.idea/.name
!/.idea/appInsightsSettings.xml
!/.idea/codeStyles/
!/.idea/compiler.xml
!/.idea/gradle.xml
!/.idea/inspectionProfiles/
!/.idea/jarRepositories.xml
!/.idea/kotlinc.xml
!/.idea/migrations.xml
!/.idea/misc.xml
!/.idea/runConfigurations.xml
!/.idea/vcs.xml

*.iml
.gradle
/local.properties
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
